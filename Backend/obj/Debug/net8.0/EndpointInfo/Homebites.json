  "components": {
    "schemas": {
      "AddressRequest": {
        "required": [
          "addressLine1",
          "addressType",
          "city",
          "fullName",
          "mobile",
          "pincode",
          "state"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "addressType": {
            "minLength": 1,
            "pattern": "^(Home|Work|Other)$",
            "type": "string"
          },
          "fullName": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "mobile": {
            "minLength": 1,
            "pattern": "^\\+91[6-9]\\d{9}$",
            "type": "string"
          },
          "addressLine1": {
            "maxLength": 200,
            "minLength": 5,
            "type": "string"
          },
          "addressLine2": {
            "type": "string",
            "nullable": true
          },
          "landmark": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "minLength": 1,
            "type": "string"
          },
          "pincode": {
            "minLength": 1,
            "pattern": "^[1-9]\\d{5}$",
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "identifier",
          "password"
        ],
        "type": "object",
        "properties": {
          "identifier": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OrderItemDto": {
        "type": "object",
        "properties": {
          "mealId": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "OrderRequest": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "addressId": {
            "type": "integer",
            "format": "int32"
          },
          "paymentMethod": {
            "type": "string",
            "nullable": true
          },
          "customerNotes": {
            "type": "string",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemDto"
            }
          }
        },
        "additionalProperties": false
      },
      "OtpRequest": {
        "required": [
          "otpCode",
          "purpose"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "mobile": {
            "type": "string",
            "nullable": true
          },
          "otpCode": {
            "minLength": 1,
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          "purpose": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequest": {
        "required": [
          "email",
          "fullName",
          "mobile",
          "password"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9._%+-]+@gmail\\.com$",
            "type": "string",
            "format": "email"
          },
          "mobile": {
            "minLength": 1,
            "pattern": "^\\+91[6-9]\\d{9}$",
            "type": "string"
          },
          "password": {
            "maxLength": 100,
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}